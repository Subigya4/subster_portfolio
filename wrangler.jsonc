{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site: `next build` (output: 'export') writes plain HTML/CSS/JS to ./out,
  // and Workers serves it as static assets. No Worker script / OpenNext needed.
  // Workers Builds must run `npm run build` as its Build command before deploying.
  "name": "subster-portfolio",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./out",
    // unknown URLs get out/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
